# .gitignore for .NET projects

# Visual Studio
.vs/
.vscode/

# Build outputs
bin/
obj/

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Local DB files
*.db
*.mdf
*.ldf

# Logs
*.log

# OS files
.DS_Store

# dotenv files
.env

# NuGet packages
*.nupkg
.packages

# Secret storage
secrets.json

# Kestrel certificate
*.pfx

# JetBrains Rider
.idea/

# Temporary files
*.tmp
